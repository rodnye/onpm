    "colors": "^1.4.0",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "fs-extra": "^11.3.0",
    "ora": "^8.2.0",
    "ora-classic": "^5.4.2",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.30",
    "@types/semver": "^7.7.0",
