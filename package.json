{
  "name": "onpm-cli",
  "version": "2.4.6",
  "description": "Offline modules manager",
  "main": "dist/main.js",
  "bin": {
    "onpm": "bin/onpm"
  },
  "keywords": [
    "dependency manager",
    "install",
    "installer",
